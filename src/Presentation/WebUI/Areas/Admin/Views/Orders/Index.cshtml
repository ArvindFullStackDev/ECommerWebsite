@model List<Order>
@{
    ViewData["Title"] = "Orders";
    var users = (Dictionary<string, string?>)ViewBag.Users;
    var status = (OrderStatus?)ViewBag.Status;
    var statuses = (OrderStatus[])ViewBag.Statuses;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Orders</h4>
</div>

<div class="mb-3 d-flex gap-2 flex-wrap">
    <a asp-action="Index" class="btn btn-sm @(status == null ? "btn-dark" : "btn-outline-dark")">All</a>
    @foreach (var s in statuses)
    {
        <a asp-action="Index" asp-route-status="@s"
           class="btn btn-sm @(status == s ? "btn-dark" : "btn-outline-dark")">@s</a>
    }
</div>

<div class="content-section p-0">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Order #</th>
                    <th>Customer</th>
                    <th class="text-end">Total</th>
                    <th>Payment</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td><small>@o.OrderNumber</small></td>
                        <td>@(users.TryGetValue(o.UserId, out var email) ? email : o.UserId)</td>
                        <td class="text-end">₹@o.GrandTotal.ToString("N2")</td>
                        <td><span class="badge bg-secondary">@o.PaymentMethod</span></td>
                        <td>
                            <span class="badge @(o.Status == OrderStatus.Cancelled ? "bg-danger" : o.Status == OrderStatus.Delivered ? "bg-success" : "bg-warning text-dark")">@o.Status</span>
                        </td>
                        <td><small class="text-muted">@o.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</small></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="fas fa-eye"></i> View
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No orders found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
