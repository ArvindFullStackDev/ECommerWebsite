@model List<UserManagementDto>
@{
    ViewData["Title"] = "Customers";
}

<h4 class="mb-3">Customers</h4>

<div class="content-section p-0">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Email</th>
                    <th>Roles</th>
                    <th class="text-center">Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    var lockLabel = u.IsLocked ? "Unlock" : "Lock";
                    var lockClass = u.IsLocked ? "btn-outline-success" : "btn-outline-danger";
                    var confirmMsg = lockLabel + " user " + u.Email + "?";
                    <tr>
                        <td>@u.Email</td>
                        <td>
                            @foreach (var r in u.Roles)
                            {
                                <span class="badge bg-info text-dark me-1">@r</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (u.IsLocked)
                            {
                                <span class="badge bg-danger">Locked</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-action="ToggleLock" method="post" class="d-inline"
                                  onsubmit="return confirm('@confirmMsg')">
                                <input type="hidden" name="id" value="@u.Id" />
                                <button type="submit" class="btn btn-sm @lockClass">
                                    @if (u.IsLocked)
                                    {
                                        <i class="fas fa-unlock me-1"></i>
                                        <text>Unlock</text>
                                    }
                                    else
                                    {
                                        <i class="fas fa-lock me-1"></i>
                                        <text>Lock</text>
                                    }
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">No customers found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
