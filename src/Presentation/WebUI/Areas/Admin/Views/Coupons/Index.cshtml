@model List<Coupon>
@{
    ViewData["Title"] = "Coupons";
    var search = (string?)ViewBag.Search;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Coupons (@Model.Count)</h4>
    <a asp-action="Create" class="btn btn-amazon"><i class="fas fa-plus me-1"></i>Add Coupon</a>
</div>

<form method="get" class="mb-3 d-flex gap-2" style="max-width: 450px;">
    <input type="text" name="search" value="@search" class="form-control" placeholder="Search by coupon code..." />
    <button type="submit" class="btn btn-amazon"><i class="fas fa-search"></i></button>
</form>

<div class="content-section p-0">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Code</th>
                    <th>Description</th>
                    <th>Discount</th>
                    <th class="text-end">Min Order</th>
                    <th class="text-center">Used</th>
                    <th>Valid Until</th>
                    <th class="text-center">Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    var expired = c.ValidTo < DateTime.UtcNow;
                    <tr class="@(c.IsActive && !expired ? "" : "table-secondary")">
                        <td>@c.Id</td>
                        <td><strong>@c.Code</strong></td>
                        <td>@c.Description</td>
                        <td>
                            @if (c.DiscountType == DiscountType.Percentage)
                            {
                                <span>@c.DiscountValue.ToString("0.##")% off</span>
                            }
                            else
                            {
                                <span>₹@c.DiscountValue.ToString("N2") off</span>
                            }
                            @if (c.MaximumDiscount.HasValue)
                            {
                                <div><small class="text-muted">Max ₹@c.MaximumDiscount.Value.ToString("N2")</small></div>
                            }
                        </td>
                        <td class="text-end">
                            @(c.MinimumOrderAmount.HasValue ? "₹" + c.MinimumOrderAmount.Value.ToString("N2") : "-")
                        </td>
                        <td class="text-center">
                            @c.UsedCount@(c.UsageLimit.HasValue ? "/" + c.UsageLimit : "")
                        </td>
                        <td>
                            @c.ValidTo.ToString("dd MMM yyyy")
                            @if (expired)
                            {
                                <span class="badge bg-danger ms-1">Expired</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (c.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                <i class="fas fa-pen"></i>
                            </a>
                            <form asp-action="ToggleActive" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@c.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Toggle active">
                                    <i class="fas fa-power-off"></i>
                                </button>
                            </form>
                            <form asp-action="Delete" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete coupon @c.Code?')">
                                <input type="hidden" name="id" value="@c.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">No coupons found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
