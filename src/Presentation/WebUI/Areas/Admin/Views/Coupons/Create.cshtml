@model Coupon
@{
    ViewData["Title"] = "Add Coupon";
}

<h4 class="mb-3">Add Coupon</h4>

<form asp-action="Create" method="post" class="content-section" style="max-width: 750px;">
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Coupon Code *</label>
            <input asp-for="Code" class="form-control" placeholder="e.g. SUMMER25" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">Description</label>
            <input asp-for="Description" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Discount Type *</label>
            <select asp-for="DiscountType" asp-items="ViewBag.DiscountTypes" class="form-select">
                <option value="">-- Select --</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Discount Value *</label>
            <input asp-for="DiscountValue" class="form-control" type="number" step="0.01" min="0" placeholder="% or ₹" />
            <span asp-validation-for="DiscountValue" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label class="form-label">Maximum Discount (₹)</label>
            <input asp-for="MaximumDiscount" class="form-control" type="number" step="0.01" min="0" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Minimum Order Amount (₹)</label>
            <input asp-for="MinimumOrderAmount" class="form-control" type="number" step="0.01" min="0" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Usage Limit</label>
            <input asp-for="UsageLimit" class="form-control" type="number" min="0" placeholder="blank = unlimited" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Valid From</label>
            <input asp-for="ValidFrom" class="form-control" type="datetime-local" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Valid To</label>
            <input asp-for="ValidTo" class="form-control" type="datetime-local" />
            <span asp-validation-for="ValidTo" class="text-danger"></span>
        </div>
        <div class="col-12">
            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label class="form-check-label">Active</label>
            </div>
        </div>
    </div>
    <div class="mt-4">
        <button type="submit" class="btn btn-amazon"><i class="fas fa-save me-1"></i>Save Coupon</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
