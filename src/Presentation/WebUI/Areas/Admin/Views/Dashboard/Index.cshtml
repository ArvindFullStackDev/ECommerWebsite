@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">Dashboard</h3>
    <span class="text-muted small">@DateTime.Now.ToString("dddd, MMMM d, yyyy")</span>
</div>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
            <div class="d-flex justify-content-between">
                <div>
                    <div class="stat-value">@ViewBag.TotalProducts</div>
                    <div class="stat-label">Total Products</div>
                </div>
                <i class="fas fa-box stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
            <div class="d-flex justify-content-between">
                <div>
                    <div class="stat-value">@ViewBag.TotalOrders</div>
                    <div class="stat-label">Total Orders</div>
                </div>
                <i class="fas fa-shopping-cart stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
            <div class="d-flex justify-content-between">
                <div>
                    <div class="stat-value">$@ViewBag.TotalRevenue?.ToString("N0")</div>
                    <div class="stat-label">Total Revenue</div>
                </div>
                <i class="fas fa-dollar-sign stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
            <div class="d-flex justify-content-between">
                <div>
                    <div class="stat-value">@ViewBag.PendingOrders</div>
                    <div class="stat-label">Pending Orders</div>
                </div>
                <i class="fas fa-clock stat-icon"></i>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-8">
        <div class="content-section">
            <h5 class="fw-bold mb-3">Recent Orders</h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Order #</th>
                            <th>Customer</th>
                            <th>Status</th>
                            <th>Total</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No recent orders</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="content-section">
            <h5 class="fw-bold mb-3">Quick Actions</h5>
            <div class="d-grid gap-2">
                <a class="btn btn-amazon" asp-area="Admin" asp-controller="Products" asp-action="Create">
                    <i class="fas fa-plus me-1"></i> Add Product
                </a>
                <a class="btn btn-outline-amazon" asp-area="Admin" asp-controller="Categories" asp-action="Create">
                    <i class="fas fa-plus me-1"></i> Add Category
                </a>
                <a class="btn btn-outline-amazon" asp-area="Admin" asp-controller="Orders" asp-action="Index">
                    <i class="fas fa-eye me-1"></i> View Orders
                </a>
            </div>
        </div>

        <div class="content-section mt-3">
            <h5 class="fw-bold mb-3">Alerts</h5>
            <div class="alert alert-warning mb-0 py-2 small">
                <i class="fas fa-exclamation-triangle me-1"></i>
                @ViewBag.LowStockProducts products are low in stock
            </div>
        </div>
    </div>
</div>
