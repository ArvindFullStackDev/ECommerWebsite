@{
    ViewData["Title"] = "Reports";
    var totalRevenue = (decimal)ViewBag.TotalRevenue;
    var totalOrders = (int)ViewBag.TotalOrders;
    var avgOrderValue = (decimal)ViewBag.AvgOrderValue;
    var totalCustomers = (int)ViewBag.TotalCustomers;
    var topProducts = (IEnumerable<dynamic>)ViewBag.TopProducts;
    var revenueByStatus = (IEnumerable<dynamic>)ViewBag.RevenueByStatus;
    var recentOrders = (List<Order>)ViewBag.RecentOrders;
}

<h4 class="mb-3">Reports</h4>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="content-section">
            <div class="text-muted small">Total Revenue</div>
            <div class="fs-4 fw-bold">₹@totalRevenue.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="content-section">
            <div class="text-muted small">Total Orders</div>
            <div class="fs-4 fw-bold">@totalOrders</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="content-section">
            <div class="text-muted small">Avg Order Value</div>
            <div class="fs-4 fw-bold">₹@avgOrderValue.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="content-section">
            <div class="text-muted small">Total Customers</div>
            <div class="fs-4 fw-bold">@totalCustomers</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="content-section p-0">
            <h6 class="p-3 mb-0 border-bottom">Top 5 Selling Products</h6>
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Product</th>
                            <th class="text-end">Units Sold</th>
                            <th class="text-end">Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in topProducts)
                        {
                            <tr>
                                <td>@p.Name</td>
                                <td class="text-end">@p.Quantity</td>
                                <td class="text-end">₹@p.Revenue.ToString("N2")</td>
                            </tr>
                        }
                        @if (!topProducts.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-4">No sales yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="content-section p-0">
            <h6 class="p-3 mb-0 border-bottom">Revenue by Order Status</h6>
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Status</th>
                            <th class="text-end">Orders</th>
                            <th class="text-end">Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in revenueByStatus)
                        {
                            <tr>
                                <td>@s.Status</td>
                                <td class="text-end">@s.Orders</td>
                                <td class="text-end">₹@s.Revenue.ToString("N2")</td>
                            </tr>
                        }
                        @if (!revenueByStatus.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-4">No orders yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="content-section p-0 mt-4">
    <h6 class="p-3 mb-0 border-bottom">Recent Orders</h6>
    <div class="table-responsive">
        <table class="table table-striped mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Order</th>
                    <th>Status</th>
                    <th class="text-end">Total</th>
                    <th>Placed</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in recentOrders)
                {
                    <tr>
                        <td>
                            <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id"
                               class="text-decoration-none">@o.OrderNumber</a>
                        </td>
                        <td>
                            @if (o.Status == OrderStatus.Delivered)
                            {
                                <span class="badge bg-success">@o.Status</span>
                            }
                            else if (o.Status == OrderStatus.Cancelled)
                            {
                                <span class="badge bg-danger">@o.Status</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">@o.Status</span>
                            }
                        </td>
                        <td class="text-end">₹@o.GrandTotal.ToString("N2")</td>
                        <td>@o.CreatedAt.ToString("dd MMM yyyy, HH:mm")</td>
                    </tr>
                }
                @if (!recentOrders.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">No orders yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
