@model List<Product>
@{
    ViewData["Title"] = "Products";
    var total = (int)ViewBag.Total;
    var page = (int)ViewBag.Page;
    var pages = (int)ViewBag.Pages;
    var search = (string?)ViewBag.Search;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Products (@total)</h4>
    <a asp-action="Create" class="btn btn-amazon"><i class="fas fa-plus me-1"></i>Add Product</a>
</div>

<form method="get" class="mb-3 d-flex gap-2" style="max-width: 450px;">
    <input type="text" name="search" value="@search" class="form-control" placeholder="Search by name or SKU..." />
    <button type="submit" class="btn btn-amazon"><i class="fas fa-search"></i></button>
</form>

<div class="content-section p-0">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Brand</th>
                    <th class="text-end">Price</th>
                    <th class="text-end">Stock</th>
                    <th class="text-center">Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr class="@(p.IsActive ? "" : "table-secondary")">
                        <td>@p.Id</td>
                        <td>
                            <a asp-controller="Catalog" asp-action="Details" asp-route-id="@p.Id" target="_blank" class="text-decoration-none">
                                @p.Name
                            </a>
                            @if (!string.IsNullOrEmpty(p.SKU))
                            {
                                <div><small class="text-muted">@p.SKU</small></div>
                            }
                        </td>
                        <td>@p.Category?.Name</td>
                        <td>@p.Brand?.Name</td>
                        <td class="text-end">₹@((p.DiscountPrice ?? p.Price).ToString("N2"))</td>
                        <td class="text-end">@p.StockQuantity</td>
                        <td class="text-center">
                            @if (p.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                <i class="fas fa-pen"></i>
                            </a>
                            <form asp-action="ToggleActive" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@p.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Toggle active">
                                    <i class="fas fa-power-off"></i>
                                </button>
                            </form>
                            <form asp-action="Delete" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete product @p.Name?')">
                                <input type="hidden" name="id" value="@p.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">No products found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (pages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm">
            @for (int i = 1; i <= pages; i++)
            {
                <li class="page-item @(i == page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-search="@search" asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
