@model Product
@{
    ViewData["Title"] = "Edit Product";
}

<h4 class="mb-3">Edit Product</h4>

<form asp-action="Edit" method="post" class="content-section" style="max-width: 900px;">
    <input type="hidden" asp-for="Id" />
    <div class="row g-3">
        <div class="col-md-8">
            <label class="form-label">Product Name *</label>
            <input asp-for="Name" class="form-control" required />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label class="form-label">SKU</label>
            <input asp-for="SKU" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Category *</label>
            <select asp-for="CategoryId" asp-items="ViewBag.CategoryList" class="form-select">
                <option value="">-- Select Category --</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Brand</label>
            <select asp-for="BrandId" asp-items="ViewBag.BrandList" class="form-select">
                <option value="">-- Select Brand --</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Barcode</label>
            <input asp-for="Barcode" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Price (₹) *</label>
            <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" required />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label class="form-label">Discount Price (₹)</label>
            <input asp-for="DiscountPrice" class="form-control" type="number" step="0.01" min="0" />
            <span asp-validation-for="DiscountPrice" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label class="form-label">Discount Type</label>
            <select asp-for="DiscountType" asp-items="ViewBag.DiscountTypes" class="form-select">
                <option value="">-- None --</option>
            </select>
            <span asp-validation-for="DiscountType" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label class="form-label">Discount Value</label>
            <input asp-for="DiscountValue" class="form-control" type="number" step="0.01" min="0" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Stock Quantity *</label>
            <input asp-for="StockQuantity" class="form-control" type="number" min="0" />
            <span asp-validation-for="StockQuantity" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label class="form-label">Low Stock Alert At</label>
            <input asp-for="LowStockThreshold" class="form-control" type="number" min="0" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Short Description</label>
            <input asp-for="ShortDescription" class="form-control" />
        </div>
        <div class="col-12">
            <label class="form-label">Full Description</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        </div>
        <div class="col-12">
            <div class="form-check form-check-inline">
                <input asp-for="IsActive" class="form-check-input" />
                <label class="form-check-label">Active</label>
            </div>
            <div class="form-check form-check-inline">
                <input asp-for="IsFeatured" class="form-check-input" />
                <label class="form-check-label">Featured</label>
            </div>
            <div class="form-check form-check-inline">
                <input asp-for="IsTrending" class="form-check-input" />
                <label class="form-check-label">Trending</label>
            </div>
            <div class="form-check form-check-inline">
                <input asp-for="IsBestSeller" class="form-check-input" />
                <label class="form-check-label">Best Seller</label>
            </div>
        </div>
    </div>
    <div class="mt-4">
        <button type="submit" class="btn btn-amazon"><i class="fas fa-save me-1"></i>Save Changes</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
