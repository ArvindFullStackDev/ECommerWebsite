@{
    ViewData["Title"] = "Settings";
    var groups = (IEnumerable<IGrouping<string?, SiteSetting>>)ViewBag.Groups;
}

<h4 class="mb-3">Site Settings</h4>

@if (TempData["SettingsSaved"] is true)
{
    <div class="alert alert-success">Settings saved successfully.</div>
}

<form asp-action="Save" method="post">
    @foreach (var group in groups)
    {
        <div class="content-section mb-4">
            <h6 class="border-bottom pb-2 mb-3">@group.Key</h6>
            <div class="row g-3">
                @foreach (var s in group)
                {
                    <div class="col-md-6">
                        <label class="form-label">@s.Key</label>
                        <input type="text" class="form-control" name="values[@s.Key]" value="@s.Value" />
                        @if (ViewData.ModelState.ContainsKey(s.Key))
                        {
                            <span class="text-danger">@ViewData.ModelState[s.Key].Errors.FirstOrDefault()?.ErrorMessage</span>
                        }
                    </div>
                }
            </div>
        </div>
    }
    <button type="submit" class="btn btn-amazon"><i class="fas fa-save me-1"></i>Save Settings</button>
</form>
