@model List<Category>
@{
    ViewData["Title"] = "Categories";
    var parents = (List<Category>)ViewBag.Parents;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Categories</h4>
    <a asp-action="Create" class="btn btn-amazon"><i class="fas fa-plus me-1"></i>Add Category</a>
</div>

<div class="content-section p-0">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Slug</th>
                    <th>Parent</th>
                    <th class="text-end">Products</th>
                    <th class="text-center">Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>
                            @c.Name
                            @if (c.ParentCategoryId == null)
                            {
                                <span class="badge bg-info ms-1">Main</span>
                            }
                        </td>
                        <td><small class="text-muted">@c.Slug</small></td>
                        <td>@(c.ParentCategory?.Name ?? "-")</td>
                        <td class="text-end">@c.Products.Count</td>
                        <td class="text-center">
                            @if (c.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary"><i class="fas fa-edit"></i></a>
                            <form asp-action="Delete" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete category @c.Name?')">
                                <input type="hidden" name="id" value="@c.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No categories found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
