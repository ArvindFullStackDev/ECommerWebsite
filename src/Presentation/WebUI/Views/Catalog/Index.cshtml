@model PagedResult<ProductDto>
@{
    ViewData["Title"] = "Products";
}

<div class="container-fluid px-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb breadcrumb-custom">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Products</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Filters Sidebar -->
        <div class="col-lg-3 mb-4">
            <div class="filter-section">
                <h6>Category</h6>
                <div class="list-group list-group-flush">
                    @foreach (var cat in (ViewBag.Categories as List<CategoryDto>) ?? new())
                    {
                        <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="@cat.Id"
                           class="list-group-item list-group-item-action border-0 py-1 ps-0 @(ViewBag.SelectedCategoryId == cat.Id ? "fw-bold text-primary" : "")">
                            @cat.Name
                        </a>
                    }
                </div>
            </div>

            <div class="filter-section">
                <h6>Brand</h6>
                <div class="list-group list-group-flush">
                    @foreach (var brand in (ViewBag.Brands as List<BrandDto>) ?? new())
                    {
                        <a asp-controller="Catalog" asp-action="Index" asp-route-brandId="@brand.Id"
                           class="list-group-item list-group-item-action border-0 py-1 ps-0 @(ViewBag.SelectedBrandId == brand.Id ? "fw-bold text-primary" : "")">
                            @brand.Name
                        </a>
                    }
                </div>
            </div>

            <div class="filter-section">
                <h6>Price</h6>
                <form asp-action="Search" method="get" class="price-range">
                    <input type="text" name="minPrice" class="form-control form-control-sm" placeholder="₹ Min" />
                    <span>to</span>
                    <input type="text" name="maxPrice" class="form-control form-control-sm" placeholder="₹ Max" />
                    <button type="submit" class="btn btn-sm btn-outline-amazon">Go</button>
                </form>
            </div>
        </div>

        <!-- Products Grid -->
        <div class="col-lg-9">
            @if (Model?.Items != null && Model.Items.Any())
            {
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <p class="mb-0 small text-muted">
                        Showing @((Model.PageIndex - 1) * Model.PageSize + 1) - @Math.Min(Model.PageIndex * Model.PageSize, Model.TotalCount)
                        of @Model.TotalCount results
                    </p>
                    <div class="d-flex align-items-center">
                        <label class="small me-2">Sort by:</label>
                        <select class="form-select form-select-sm" style="width: auto;" onchange="location.href='@Url.Action("Index")?sortBy='+this.value">
                            <option value="">Featured</option>
                            <option value="price_asc" selected="@(ViewBag.SelectedSortBy == "price_asc")">Price: Low to High</option>
                            <option value="price_desc" selected="@(ViewBag.SelectedSortBy == "price_desc")">Price: High to Low</option>
                            <option value="newest" selected="@(ViewBag.SelectedSortBy == "newest")">Newest</option>
                            <option value="bestseller" selected="@(ViewBag.SelectedSortBy == "bestseller")">Best Seller</option>
                            <option value="rating" selected="@(ViewBag.SelectedSortBy == "rating")">Avg. Rating</option>
                        </select>
                    </div>
                </div>

                <div class="row g-3">
                    @foreach (var product in Model.Items)
                    {
                        <div class="col-6 col-md-4 col-lg-3">
                            <partial name="_ProductCard" model="product" />
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-4">
                        <ul class="pagination pagination-custom justify-content-center">
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" asp-controller="Catalog" asp-action="Index" asp-route-page="@(Model.PageIndex - 1)">&laquo; Previous</a>
                            </li>
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                    <a class="page-link" asp-controller="Catalog" asp-action="Index" asp-route-page="@i">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link" asp-controller="Catalog" asp-action="Index" asp-route-page="@(Model.PageIndex + 1)">Next &raquo;</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
                    <h4>No products found</h4>
                    <p class="text-muted">Try adjusting your search or filter criteria</p>
                    <a asp-controller="Catalog" asp-action="Index" class="btn btn-amazon">Clear Filters</a>
                </div>
            }
        </div>
    </div>
</div>
