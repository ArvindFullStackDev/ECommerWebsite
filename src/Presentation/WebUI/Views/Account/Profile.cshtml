@{
    ViewData["Title"] = "Your Account";
}

<div class="container py-4" style="max-width: 900px;">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb breadcrumb-custom">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Your Account</li>
        </ol>
    </nav>

    <h2 class="mb-4">Your Account</h2>

    <div class="row g-3">
        <div class="col-sm-6 col-lg-4">
            <a asp-controller="Order" asp-action="Index" class="card h-100 text-decoration-none shadow-sm">
                <div class="card-body text-center p-4">
                    <i class="fas fa-box-open fa-3x text-amazon mb-3"></i>
                    <h6 class="mb-0">Your Orders</h6>
                    <small class="text-muted">Track, return, or buy things again</small>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-lg-4">
            <a asp-controller="Account" asp-action="Addresses" class="card h-100 text-decoration-none shadow-sm">
                <div class="card-body text-center p-4">
                    <i class="fas fa-map-marker-alt fa-3x text-amazon mb-3"></i>
                    <h6 class="mb-0">Your Addresses</h6>
                    <small class="text-muted">Manage your shipping addresses</small>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-lg-4">
            <a asp-controller="Wishlist" asp-action="Index" class="card h-100 text-decoration-none shadow-sm">
                <div class="card-body text-center p-4">
                    <i class="fas fa-heart fa-3x text-amazon mb-3"></i>
                    <h6 class="mb-0">Your Wishlist</h6>
                    <small class="text-muted">Items you saved for later</small>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-lg-4">
            <a asp-controller="Cart" asp-action="Index" class="card h-100 text-decoration-none shadow-sm">
                <div class="card-body text-center p-4">
                    <i class="fas fa-shopping-cart fa-3x text-amazon mb-3"></i>
                    <h6 class="mb-0">Your Cart</h6>
                    <small class="text-muted">Review and checkout your items</small>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-lg-4">
            <a asp-controller="Account" asp-action="Profile" class="card h-100 text-decoration-none shadow-sm">
                <div class="card-body text-center p-4">
                    <i class="fas fa-user-cog fa-3x text-amazon mb-3"></i>
                    <h6 class="mb-0">Login & Security</h6>
                    <small class="text-muted">Update your password and email</small>
                </div>
            </a>
        </div>
    </div>
</div>
