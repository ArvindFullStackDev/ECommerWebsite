@model List<Address>
@{
    ViewData["Title"] = "Your Addresses";
}

<div class="container py-4" style="max-width: 900px;">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb breadcrumb-custom">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Account" asp-action="Profile">Your Account</a></li>
            <li class="breadcrumb-item active" aria-current="page">Your Addresses</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Your Addresses</h2>
        <a asp-action="AddAddress" class="btn btn-amazon"><i class="fas fa-plus me-1"></i> Add Address</a>
    </div>

    <div class="row g-3">
        @foreach (var addr in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h6 class="fw-bold">
                            @addr.FullName
                            @if (addr.IsDefault)
                            {
                                <span class="badge bg-success">Default</span>
                            }
                        </h6>
                        <address class="small mb-3">
                            @addr.AddressLine1<br />
                            @if (!string.IsNullOrEmpty(addr.AddressLine2))
                            {
                                @addr.AddressLine2<br />
                            }
                            @addr.City, @addr.State @addr.ZipCode<br />
                            @addr.Country<br />
                            Phone: @addr.PhoneNumber
                        </address>
                        <a asp-action="EditAddress" asp-route-id="@addr.Id" class="btn btn-sm btn-outline-amazon me-1">Edit</a>
                        <form asp-action="RemoveAddress" method="post" class="d-inline"
                              onsubmit="return confirm('Remove this address?')">
                            <input type="hidden" name="id" value="@addr.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                        </form>
                    </div>
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="alert alert-info">
                    No addresses saved yet. <a asp-action="AddAddress">Add your first address</a>.
                </div>
            </div>
        }
    </div>
</div>