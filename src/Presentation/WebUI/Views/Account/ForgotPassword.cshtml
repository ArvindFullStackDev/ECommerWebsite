@model ForgotPasswordRequest
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-container">
    <div class="auth-box">
        <h1 class="fs-4">Forgot your password?</h1>
        <p class="text-muted small">Enter your email address and we'll send you a link to reset your password.</p>

        <form asp-action="ForgotPassword" method="post">
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" type="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-amazon-yellow">Send reset link</button>
        </form>

        <div class="mt-3 text-center">
            <a asp-action="Login" class="small text-decoration-none">Back to sign in</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
