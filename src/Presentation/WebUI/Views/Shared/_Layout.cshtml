<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ECommerce</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Top Navigation Bar -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark amazon-nav">
            <div class="container-fluid">
                <a class="navbar-brand amazon-logo" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-shopping-bag"></i> E<span>Commerce</span>
                </a>

                <!-- Location -->
                <div class="d-none d-lg-flex align-items-center text-white me-3 location-box">
                    <i class="fas fa-map-marker-alt me-1"></i>
                    <div class="location-text">
                        <span class="d-block small text-muted">Deliver to</span>
                        <span class="fw-bold">New York 10001</span>
                    </div>
                </div>

                <!-- Search -->
                <form class="d-flex flex-grow-1 mx-3 search-form" asp-controller="Catalog" asp-action="Search" method="get">
                    <div class="input-group">
                        <select name="categoryId" class="form-select search-category-select" style="max-width: 160px; background: #f3f3f3; border: none; font-size: 14px;">
                            <option value="">All</option>
                        </select>
                        <input type="text" name="searchTerm" class="form-control search-input" placeholder="Search products..." aria-label="Search" />
                        <button class="btn search-btn" type="submit">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </form>

                <!-- Right Nav -->
                <div class="d-flex align-items-center">
                    <partial name="_LoginPartial" />

                    <a class="nav-link text-white text-center position-relative me-2" asp-controller="Wishlist" asp-action="Index">
                        <i class="fas fa-heart"></i>
                        <span class="d-none d-lg-block small">Wishlist</span>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger wishlist-count">0</span>
                    </a>

                    <a class="nav-link text-white text-center cart-link" asp-controller="Cart" asp-action="Index">
                        <i class="fas fa-shopping-cart"></i>
                        <span class="d-none d-lg-block small">Cart</span>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger cart-count">0</span>
                    </a>
                </div>
            </div>
        </nav>

        <!-- Secondary Nav / Categories -->
        <div class="amazon-nav-secondary">
            <nav class="navbar navbar-expand-lg navbar-dark">
                <div class="container-fluid">
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#categoryNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="categoryNav">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <a class="nav-link" href="#"><i class="fas fa-bars me-1"></i>All</a>
                            </li>
                            <li class="nav-item dropdown mega-menu">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Electronics</a>
                                <div class="dropdown-menu mega-menu-content">
                                    <div class="row p-3">
                                        <div class="col-md-3">
                                            <h6 class="fw-bold">Computers</h6>
                                            <a class="dropdown-item" href="#">Laptops</a>
                                            <a class="dropdown-item" href="#">Desktops</a>
                                            <a class="dropdown-item" href="#">Tablets</a>
                                            <a class="dropdown-item" href="#">Monitors</a>
                                            <h6 class="fw-bold mt-3">Accessories</h6>
                                            <a class="dropdown-item" href="#">Keyboards</a>
                                            <a class="dropdown-item" href="#">Mice</a>
                                        </div>
                                        <div class="col-md-3">
                                            <h6 class="fw-bold">Mobile Phones</h6>
                                            <a class="dropdown-item" href="#">Smartphones</a>
                                            <a class="dropdown-item" href="#">Cases & Covers</a>
                                            <a class="dropdown-item" href="#">Screen Protectors</a>
                                            <a class="dropdown-item" href="#">Chargers</a>
                                        </div>
                                        <div class="col-md-3">
                                            <h6 class="fw-bold">Audio</h6>
                                            <a class="dropdown-item" href="#">Headphones</a>
                                            <a class="dropdown-item" href="#">Earbuds</a>
                                            <a class="dropdown-item" href="#">Speakers</a>
                                            <a class="dropdown-item" href="#">Soundbars</a>
                                        </div>
                                        <div class="col-md-3">
                                            <h6 class="fw-bold">TV & Home</h6>
                                            <a class="dropdown-item" href="#">Televisions</a>
                                            <a class="dropdown-item" href="#">Streaming Devices</a>
                                            <a class="dropdown-item" href="#">Home Audio</a>
                                        </div>
                                    </div>
                                </div>
                            </li>
                            <li class="nav-item"><a class="nav-link" href="#">Clothing</a></li>
                            <li class="nav-item"><a class="nav-link" href="#">Home & Garden</a></li>
                            <li class="nav-item"><a class="nav-link" href="#">Books</a></li>
                            <li class="nav-item"><a class="nav-link" href="#">Sports</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Catalog" asp-action="Deals">Today's Deals</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Catalog" asp-action="BestSellers">Best Sellers</a></li>
                        </ul>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <!-- Main Content -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Toast Notification -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="liveToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <i class="fas fa-check-circle text-success me-2"></i>
                <strong class="me-auto">Notification</strong>
                <small>just now</small>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body"></div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="amazon-footer mt-auto">
        <div class="footer-back-to-top">
            <a href="#top" class="text-white text-decoration-none">Back to top</a>
        </div>
        <div class="footer-main">
            <div class="container">
                <div class="row">
                    <div class="col-md-3 col-6 mb-4">
                        <h6>Get to Know Us</h6>
                        <ul class="list-unstyled">
                            <li><a asp-controller="Home" asp-action="About">About Us</a></li>
                            <li><a href="#">Careers</a></li>
                            <li><a href="#">Press Releases</a></li>
                            <li><a href="#">Blog</a></li>
                        </ul>
                    </div>
                    <div class="col-md-3 col-6 mb-4">
                        <h6>Customer Service</h6>
                        <ul class="list-unstyled">
                            <li><a asp-controller="Home" asp-action="Contact">Contact Us</a></li>
                            <li><a asp-controller="Home" asp-action="FAQ">FAQ</a></li>
                            <li><a asp-controller="Home" asp-action="ReturnPolicy">Return Policy</a></li>
                            <li><a asp-controller="Home" asp-action="ShippingPolicy">Shipping Policy</a></li>
                        </ul>
                    </div>
                    <div class="col-md-3 col-6 mb-4">
                        <h6>Make Money with Us</h6>
                        <ul class="list-unstyled">
                            <li><a href="#">Sell products</a></li>
                            <li><a href="#">Affiliate Program</a></li>
                            <li><a href="#">Advertise</a></li>
                        </ul>
                    </div>
                    <div class="col-md-3 col-6 mb-4">
                        <h6>Let Us Help You</h6>
                        <ul class="list-unstyled">
                            <li><a asp-controller="Account" asp-action="Profile">Your Account</a></li>
                            <li><a asp-controller="Order" asp-action="Index">Your Orders</a></li>
                            <li><a href="#">Shipping Rates</a></li>
                            <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                        </ul>
                    </div>
                </div>
                <hr class="border-secondary">
                <div class="row align-items-center">
                    <div class="col-md-4 text-center text-md-start mb-3 mb-md-0">
                        <a class="navbar-brand amazon-logo" asp-controller="Home" asp-action="Index">
                            <i class="fas fa-shopping-bag"></i> E<span>Commerce</span>
                        </a>
                    </div>
                    <div class="col-md-8 text-center text-md-end">
                        <span class="text-muted small">Conditions of Use & Sale &copy; @DateTime.Now.Year ECommerce. All rights reserved.</span>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
