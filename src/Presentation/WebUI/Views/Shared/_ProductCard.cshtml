@model ProductDto
<div class="card product-card shadow-sm">
    <a asp-controller="Catalog" asp-action="Details" asp-route-id="@Model.Id">
        <img src="@(Model.PrimaryImageUrl ?? "/images/products/product.svg")" class="card-img-top" alt="@Model.Name">
    </a>
    <div class="card-body">
        <h5 class="card-title">
            <a asp-controller="Catalog" asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a>
        </h5>
        <div class="mb-2">
            <span class="star-rating">
                @for (int i = 1; i <= 5; i++)
                {
                    if (i <= Math.Round(Model.AverageRating))
                    {
                        <i class="fas fa-star"></i>
                    }
                    else
                    {
                        <i class="far fa-star empty-star"></i>
                    }
                }
                <span class="rating-text">(@Model.ReviewCount)</span>
            </span>
        </div>
        <div class="product-price mb-2">
            <span class="currency-symbol">₹</span>
            <span>@Model.DisplayPrice?.ToString("N2")</span>
            @if (Model.Savings > 0)
            {
                <span class="original-price ms-2">₹@Model.Price.ToString("N2")</span>
                <span class="product-discount ms-2">-@Model.SavingsPercent%</span>
            }
        </div>
        @if (Model.StockQuantity <= 0)
        {
            <span class="badge bg-danger w-100 mt-2">Out of Stock</span>
        }
        else
        {
            <button class="btn btn-amazon mt-2 add-to-cart" data-product-id="@Model.Id">
                <i class="fas fa-shopping-cart me-1"></i> Add to Cart
            </button>
        }
    </div>
</div>
