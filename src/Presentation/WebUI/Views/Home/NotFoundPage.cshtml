@{
    ViewData["Title"] = "Page Not Found";
}

<div class="container py-5 text-center" style="max-width: 600px;">
    <i class="fas fa-search fa-4x text-muted mb-3"></i>
    <h1 class="display-4">404</h1>
    <h4>Page Not Found</h4>
    <p class="text-muted">We couldn't find the page you were looking for. It may have been moved or removed.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-amazon">Back to Home</a>
</div>
