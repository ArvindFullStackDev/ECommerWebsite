@model List<Wishlist>
@{
    ViewData["Title"] = "My Wishlist";
}

<div class="container-fluid px-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb breadcrumb-custom">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active">Wishlist</li>
        </ol>
    </nav>

    <div class="content-section">
        <div class="section-header">
            <h2>My Wishlist (@Model.Count items)</h2>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-heart fa-4x text-muted mb-3"></i>
                <h4>Your wishlist is empty</h4>
                <p class="text-muted">Save your favorite items here!</p>
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-amazon">Browse Products</a>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var item in Model)
                {
                    <div class="col-6 col-md-3 col-lg-2">
                        <div class="card product-card shadow-sm">
                            <a asp-controller="Catalog" asp-action="Details" asp-route-id="@item.ProductId">
                                <img src="@(item.Product.Images.                                            FirstOrDefault()?.ImageUrl ?? "/images/products/product.svg")" class="card-img-top" alt="@item.Product.Name">
                            </a>
                            <div class="card-body">
                                <h5 class="card-title">
                                    <a asp-controller="Catalog" asp-action="Details" asp-route-id="@item.ProductId">@item.Product.Name</a>
                                </h5>
                                <div class="product-price mb-2">
                                    ₹@((item.Product.DiscountPrice ?? item.Product.Price).ToString("N2"))
                                </div>
                                <button class="btn btn-amazon btn-sm w-100 mb-1 add-to-cart" data-product-id="@item.ProductId">
                                    <i class="fas fa-shopping-cart me-1"></i>Add to Cart
                                </button>
                                <form asp-controller="Wishlist" asp-action="RemoveFromWishlist" method="post"
                                      onsubmit="return confirm('Remove from wishlist?')" class="d-grid">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                        <i class="fas fa-trash me-1"></i>Remove
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
