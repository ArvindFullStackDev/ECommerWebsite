@model CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

<div class="container-fluid px-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb breadcrumb-custom">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Cart" asp-action="Index">Cart</a></li>
            <li class="breadcrumb-item active">Checkout</li>
        </ol>
    </nav>

    <form asp-action="PlaceOrder" method="post" id="checkoutForm">
        <div class="row g-4">
            <!-- Left: Address & Payment -->
            <div class="col-lg-8">
                <!-- Shipping Address -->
                <div class="content-section">
                    <h5 class="fw-bold mb-3">1. Shipping Address</h5>
                    @if (Model.Addresses.Any())
                    {
                        <div class="row g-2">
                            @foreach (var addr in Model.Addresses)
                            {
                                <div class="col-md-6">
                                    <div class="border rounded p-3 @(addr.IsDefault ? "border-primary" : "")">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="ShippingAddressId" value="@addr.Id"
                                                   @(addr.IsDefault ? "checked" : "") required>
                                            <label class="form-check-label">
                                                <strong>@addr.FullName</strong><br />
                                                <span class="small">@addr.AddressLine1, @addr.City, @addr.State @addr.ZipCode</span><br />
                                                <span class="small text-muted">Phone: @addr.PhoneNumber</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No addresses found. <a asp-controller="Account" asp-action="Addresses">Add an address</a></p>
                    }
                </div>

                <!-- Shipping Method -->
                <div class="content-section">
                    <h5 class="fw-bold mb-3">2. Shipping Method</h5>
                    <div class="row g-2">
                        <div class="col-md-4">
                            <div class="border rounded p-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="ShippingMethod" value="0" checked>
                                    <label class="form-check-label">
                                        <strong>Standard</strong><br />
                                        <span class="small text-muted">5-7 business days</span><br />
                                        <span class="small">@(Model.SubTotal >= 50 ? "FREE" : "$5.99")</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="ShippingMethod" value="1">
                                    <label class="form-check-label">
                                        <strong>Express</strong><br />
                                        <span class="small text-muted">2-3 business days</span><br />
                                        <span class="small">$12.99</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="ShippingMethod" value="2">
                                    <label class="form-check-label">
                                        <strong>Overnight</strong><br />
                                        <span class="small text-muted">Next business day</span><br />
                                        <span class="small">$24.99</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Payment Method -->
                <div class="content-section">
                    <h5 class="fw-bold mb-3">3. Payment Method</h5>
                    <div class="row g-2">
                        <div class="col-md-4">
                            <div class="border rounded p-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="PaymentMethod" value="1" checked>
                                    <label class="form-check-label">
                                        <i class="fas fa-money-bill-wave me-1"></i>
                                        <strong>Cash on Delivery</strong>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="PaymentMethod" value="2">
                                    <label class="form-check-label">
                                        <i class="fas fa-credit-card me-1"></i>
                                        <strong>Credit/Debit Card</strong>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="PaymentMethod" value="4">
                                    <label class="form-check-label">
                                        <i class="fas fa-mobile-alt me-1"></i>
                                        <strong>UPI</strong>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Order Summary -->
            <div class="col-lg-4">
                <div class="cart-sidebar">
                    <h5 class="fw-bold mb-3">Order Summary</h5>

                    <div class="mb-3">
                        @foreach (var item in Model.CartItems)
                        {
                            <div class="d-flex align-items-center mb-2">
                                <img src="https://via.placeholder.com/40x40" class="rounded me-2" style="width:40px;height:40px;object-fit:cover;">
                                <div class="flex-grow-1 small">
                                    <span class="d-block text-truncate" style="max-width:180px;">@item.Product.Name</span>
                                    <span class="text-muted">Qty: @item.Quantity</span>
                                </div>
                                <span class="small">$@((item.UnitPrice * item.Quantity).ToString("N2"))</span>
                            </div>
                        }
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between mb-1 small">
                        <span class="text-muted">Subtotal:</span>
                        <span>$@Model.SubTotal.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1 small">
                        <span class="text-muted">Shipping:</span>
                        <span>@(Model.ShippingCharge == 0 ? "FREE" : "$" + Model.ShippingCharge.ToString("N2"))</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1 small">
                        <span class="text-muted">Tax:</span>
                        <span>$@Model.TaxAmount.ToString("N2")</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between mb-3">
                        <strong>Total:</strong>
                        <strong class="product-price">$@Model.GrandTotal.ToString("N2")</strong>
                    </div>

                    <button type="submit" class="btn btn-amazon btn-lg w-100" id="placeOrderBtn">
                        <i class="fas fa-lock me-2"></i>Place Order
                    </button>
                    <p class="text-center text-muted small mt-2">
                        <i class="fas fa-shield-alt me-1"></i>Secure checkout
                    </p>
                </div>
            </div>
        </div>
    </form>
</div>