@model CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

<div class="container-fluid px-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb breadcrumb-custom">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Cart" asp-action="Index">Cart</a></li>
            <li class="breadcrumb-item active">Checkout</li>
        </ol>
    </nav>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

    <form asp-action="PlaceOrder" method="post" id="checkoutForm">
        <div class="row g-4">
            <!-- Left: Address & Payment -->
            <div class="col-lg-8">
                <!-- Shipping Address -->
                <div class="content-section">
                    <h5 class="fw-bold mb-3">1. Shipping Address</h5>
                    @if (Model.Addresses.Any())
                    {
                        <div class="row g-2 mb-3">
                            @foreach (var addr in Model.Addresses)
                            {
                                <div class="col-md-6">
                                    <div class="border rounded p-3 address-option @(addr.IsDefault ? "border-primary" : "")"
                                         data-address-card="1">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="ShippingAddressId" value="@addr.Id"
                                                   @(Model.Form.ShippingAddressId == addr.Id ? "checked" : "")>
                                            <label class="form-check-label">
                                                <strong>@addr.FullName</strong><br />
                                                <span class="small">@addr.AddressLine1, @addr.City, @addr.State @addr.ZipCode</span><br />
                                                <span class="small text-muted">Phone: @addr.PhoneNumber</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            }
                            <div class="col-md-6">
                                <div class="border rounded p-3 address-option h-100" data-address-card="1">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="ShippingAddressId" value="0"
                                               @(Model.Form.ShippingAddressId == 0 ? "checked" : "")>
                                        <label class="form-check-label">
                                            <strong>New Address</strong><br />
                                            <span class="small text-muted">Enter a new shipping address below</span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="row g-2" id="newAddressFields">
                        <div class="col-md-6">
                            <label class="form-label">Full Name *</label>
                            <input name="FullName" class="form-control" value="@(Model.Form.FullName)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone Number *</label>
                            <input name="PhoneNumber" class="form-control" value="@(Model.Form.PhoneNumber)" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Address Line 1 *</label>
                            <input name="AddressLine1" class="form-control" value="@(Model.Form.AddressLine1)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Address Line 2</label>
                            <input name="AddressLine2" class="form-control" value="@(Model.Form.AddressLine2)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">City *</label>
                            <input name="City" class="form-control" value="@(Model.Form.City)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">State *</label>
                            <input name="State" class="form-control" value="@(Model.Form.State)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Zip Code *</label>
                            <input name="ZipCode" class="form-control" value="@(Model.Form.ZipCode)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Country</label>
                            <input name="Country" class="form-control" value="@(Model.Form.Country ?? "India")" />
                        </div>
                    </div>
                </div>

                <!-- Shipping Method -->
                <div class="content-section">
                    <h5 class="fw-bold mb-3">2. Shipping Method</h5>
                    <div class="row g-2">
                        <div class="col-md-4">
                            <div class="border rounded p-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="ShippingMethod" value="1" checked>
                                    <label class="form-check-label">
                                        <strong>Standard</strong><br />
                                        <span class="small text-muted">5-7 business days</span><br />
                                        <span class="small">@(Model.SubTotal >= 4250 ? "FREE" : "₹509.15")</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="ShippingMethod" value="2">
                                    <label class="form-check-label">
                                        <strong>Express</strong><br />
                                        <span class="small text-muted">2-3 business days</span><br />
                                        <span class="small">₹1,104.15</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="ShippingMethod" value="3">
                                    <label class="form-check-label">
                                        <strong>Overnight</strong><br />
                                        <span class="small text-muted">Next business day</span><br />
                                        <span class="small">₹2,124.15</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Payment Method -->
                <div class="content-section">
                    <h5 class="fw-bold mb-3">3. Payment Method</h5>
                    <div class="row g-2">
                        <div class="col-md-3">
                            <div class="border rounded p-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="PaymentMethod" value="1" checked>
                                    <label class="form-check-label">
                                        <i class="fas fa-money-bill-wave me-1"></i>
                                        <strong>Cash on Delivery</strong>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="border rounded p-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="PaymentMethod" value="2">
                                    <label class="form-check-label">
                                        <i class="fas fa-credit-card me-1"></i>
                                        <strong>Credit/Debit Card</strong>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="border rounded p-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="PaymentMethod" value="5">
                                    <label class="form-check-label">
                                        <i class="fas fa-mobile-alt me-1"></i>
                                        <strong>UPI</strong>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="border rounded p-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="PaymentMethod" value="6">
                                    <label class="form-check-label">
                                        <i class="fas fa-university me-1"></i>
                                        <strong>Net Banking</strong>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Order Summary -->
            <div class="col-lg-4">
                <div class="cart-sidebar" data-subtotal="@Model.SubTotal.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)">
                    <h5 class="fw-bold mb-3">Order Summary</h5>

                    <div class="mb-3">
                        @foreach (var item in Model.CartItems)
                        {
                            <div class="d-flex align-items-center mb-2">
                                <img src="/images/products/product-small.svg" class="rounded me-2" style="width:40px;height:40px;object-fit:cover;">
                                <div class="flex-grow-1 small">
                                    <span class="d-block text-truncate" style="max-width:180px;">@item.Product.Name</span>
                                    <span class="text-muted">Qty: @item.Quantity</span>
                                </div>
                                <span class="small">₹@((item.UnitPrice * item.Quantity).ToString("N2"))</span>
                            </div>
                        }
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between mb-1 small">
                        <span class="text-muted">Subtotal:</span>
                        <span>₹@Model.SubTotal.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1 small">
                        <span class="text-muted">Shipping:</span>
                        <span id="summaryShipping">@(Model.ShippingCharge == 0 ? "FREE" : "₹" + Model.ShippingCharge.ToString("N2"))</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1 small">
                        <span class="text-muted">Tax:</span>
                        <span id="summaryTax">₹@Model.TaxAmount.ToString("N2")</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between mb-3">
                        <strong>Total:</strong>
                        <strong class="product-price" id="summaryTotal">₹@Model.GrandTotal.ToString("N2")</strong>
                    </div>

                    <button type="submit" class="btn btn-amazon btn-lg w-100" id="placeOrderBtn">
                        <i class="fas fa-lock me-2"></i>Place Order
                    </button>
                    <p class="text-center text-muted small mt-2">
                        <i class="fas fa-shield-alt me-1"></i>Secure checkout
                    </p>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    (function () {
        var summary = document.querySelector('.cart-sidebar');
        var subtotal = parseFloat(summary.getAttribute('data-subtotal')) || 0;
        var freeThreshold = 4250;
        var rates = {
            '1': { amount: 509.15, free: true },
            '2': { amount: 1104.15, free: false },
            '3': { amount: 2124.15, free: false }
        };
        var taxRate = 0.085;

        function fmt(n) {
            return '\u20B9' + n.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function update() {
            var selected = document.querySelector('input[name="ShippingMethod"]:checked');
            if (!selected) return;
            var rate = rates[selected.value];
            if (!rate) return;
            var shipping = rate.free && subtotal >= freeThreshold ? 0 : rate.amount;
            var tax = subtotal * taxRate;
            var total = subtotal + tax + shipping;
            document.getElementById('summaryShipping').textContent =
                rate.free && shipping === 0 ? 'FREE' : fmt(shipping);
            document.getElementById('summaryTax').textContent = fmt(tax);
            document.getElementById('summaryTotal').textContent = fmt(total);
        }

        document.querySelectorAll('input[name="ShippingMethod"]').forEach(function (radio) {
            radio.addEventListener('change', update);
        });
        update();

        var newAddressFields = document.getElementById('newAddressFields');
        var addressRadios = document.querySelectorAll('input[name="ShippingAddressId"]');
        function syncAddressFields() {
            var usingSaved = document.querySelector('input[name="ShippingAddressId"]:checked');
            var usingNewAddress = usingSaved && usingSaved.value === '0';
            var disableFields = !!usingSaved && !usingNewAddress;
            newAddressFields.querySelectorAll('input').forEach(function (input) {
                input.disabled = disableFields;
                input.classList.toggle('disabled', disableFields);
            });
            newAddressFields.style.opacity = disableFields ? '0.55' : '1';
            document.querySelectorAll('[data-address-card]').forEach(function (card) {
                var radio = card.querySelector('input[name="ShippingAddressId"]');
                card.classList.toggle('border-primary', radio && radio.checked);
            });
        }
        addressRadios.forEach(function (radio) {
            radio.addEventListener('change', syncAddressFields);
        });
        if (addressRadios.length) syncAddressFields();
    })();
</script>
