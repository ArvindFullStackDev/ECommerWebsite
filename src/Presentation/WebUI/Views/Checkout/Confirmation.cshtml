@model Order
@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="container-fluid px-4 py-5">
    <div class="text-center mb-4">
        <i class="fas fa-check-circle text-success" style="font-size: 64px;"></i>
        <h2 class="mt-3">Order Placed Successfully!</h2>
        <p class="text-muted">Thank you for your purchase. Your order has been received.</p>
    </div>

    <div class="content-section">
        <div class="row g-3">
            <div class="col-md-6">
                <table class="table table-borderless small">
                    <tr><td class="text-muted">Order Number:</td><td class="fw-bold">@Model.OrderNumber</td></tr>
                    <tr><td class="text-muted">Date:</td><td>@Model.CreatedAt.ToString("MMM dd, yyyy")</td></tr>
                    <tr><td class="text-muted">Status:</td><td><span class="badge bg-warning text-dark">@Model.Status</span></td></tr>
                    <tr><td class="text-muted">Payment:</td><td>@Model.PaymentMethod</td></tr>
                </table>
            </div>
            <div class="col-md-6">
                <table class="table table-borderless small">
                    <tr><td class="text-muted">Subtotal:</td><td>₹@Model.SubTotal.ToString("N2")</td></tr>
                    <tr><td class="text-muted">Shipping:</td><td>₹@Model.ShippingCharge.ToString("N2")</td></tr>
                    <tr><td class="text-muted">Tax:</td><td>₹@Model.TaxAmount.ToString("N2")</td></tr>
                    <tr><td class="fw-bold">Total:</td><td class="fw-bold product-price">₹@Model.GrandTotal.ToString("N2")</td></tr>
                </table>
            </div>
        </div>

        @if (Model.Items.Any())
        {
            <hr />
            <h6 class="fw-bold mb-3">Items Ordered</h6>
            @foreach (var item in Model.Items)
            {
                <div class="d-flex align-items-center mb-2">
                    <div class="flex-grow-1">@item.Product.Name <span class="text-muted">x @item.Quantity</span></div>
                    <span>₹@item.TotalPrice.ToString("N2")</span>
                </div>
            }
        }
    </div>

    <div class="text-center mt-3">
        <a asp-controller="Order" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-amazon me-2">
            <i class="fas fa-eye me-1"></i>View Order
        </a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-amazon">
            <i class="fas fa-home me-1"></i>Continue Shopping
        </a>
    </div>
</div>